initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$stop;
end 
endmodule

module RAM32x32_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [4:0] ADDR;
reg [31:0] treg_IO;
reg RWS;
// wires                                               
wire [31:0] IO;

wire sampler;                             

// assign statements (if any)                          
assign IO = treg_IO;
RAM32x32 i1 (
// port map - connection between master ports and signals/registers   
	.ADDR(ADDR),
	.IO(IO),
	.RWS(RWS)
);

// RWS
initial
begin
	RWS = 1'b0;
	RWS = #60000 1'b1;
	RWS = #60000 1'b0;
	RWS = #120000 1'b1;
	RWS = #70000 1'b0;
end 

// ADDR[1]
initial
begin

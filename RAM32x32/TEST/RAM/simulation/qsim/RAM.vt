// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "10/24/2025 10:38:45"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    RAM32x32
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module RAM32x32_vlg_sample_tst(
	ADDR,
	CS,
	IO,
	RWS,
	sampler_tx
);
input [4:0] ADDR;
input  CS;
input [31:0] IO;
input  RWS;
output sampler_tx;

reg sample;
time current_time;
always @(ADDR or CS or IO or RWS)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module RAM32x32_vlg_check_tst (
	IO,
	sampler_rx
);
input [31:0] IO;
input sampler_rx;

reg [31:0] IO_expected;

reg [31:0] IO_prev;

reg [31:0] IO_expected_prev;

reg [31:0] last_IO_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:1] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 1'b1;
end

// update real /o prevs

always @(trigger)
begin
	IO_prev = IO;
end

// update expected /o prevs

always @(trigger)
begin
	IO_expected_prev = IO_expected;
end


// generate trigger
always @(IO_expected or IO)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected IO = %b | ",IO_expected_prev);
	$display("| real IO = %b | ",IO_prev);
`endif
	if (
		( IO_expected_prev[0] !== 1'bx ) && ( IO_prev[0] !== IO_expected_prev[0] )

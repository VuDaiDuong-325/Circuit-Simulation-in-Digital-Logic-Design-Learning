PD_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.Enable(Enable),
	.IO(IO),
	.Push/Pop(Push/Pop),
	.Reset(Reset),
	.sampler_tx(sampler)
);

PD_vlg_check_tst tb_out(
	.Empty(Empty),
	.Full(Full),
	.IO(IO),
	.sampler_rx(sampler)
);
endmodule


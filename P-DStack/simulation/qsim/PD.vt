		on_first_change[3] = 1'b0;
		last_IO_exp[30] = IO_expected_prev[30];
	end
	if (
		( IO_expected_prev[31] !== 1'bx ) && ( IO_prev[31] !== IO_expected_prev[31] )
		&& ((IO_expected_prev[31] !== last_IO_exp[31]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO[31] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO_expected_prev);
		$display ("     Real value = %b", IO_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_IO_exp[31] = IO_expected_prev[31];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#640000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module PD_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg Enable;
reg [31:0] treg_IO;
reg Push/Pop;
reg Reset;
// wires                                               
wire Empty;
wire Full;
wire [31:0] IO;

wire sampler;                             

// assign statements (if any)                          
assign IO = treg_IO;
PD i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.Empty(Empty),
	.Enable(Enable),
	.Full(Full),
	.IO(IO),
	.\Push/Pop (Push/Pop),
	.Reset(Reset)
);

// CLK
initial
begin
	CLK = 1'b1;
	# 2000;
	repeat(63)
	begin
		CLK = 1'b0;
		CLK = #5000 1'b1;
		# 5000;
	end
	CLK = 1'b0;
	CLK = #5000 1'b1;
end 

// Enable
initial
begin
	Enable = 1'b1;
end 

// Reset
initial
begin
	Reset = 1'b1;
	Reset = #20000 1'b0;
end 

// Push/Pop
initial
begin
	Push/Pop = 1'b0;
	Push/Pop = #330000 1'b1;
end 
// IO[ 31 ]
initial
begin
	treg_IO[31] = 1'b0;
	treg_IO[31] = #340000 1'bZ;
end 
// IO[ 30 ]
initial
begin
	treg_IO[30] = 1'b0;
	treg_IO[30] = #340000 1'bZ;
end 
